+_TERM_SPLIT = re.compile(r"[\s,，。;；、/|]+")
+_MAX_TERMS = 8
+
+
+def _terms(q: str) -> list[str]:
+    """检索词：中文没有空格，靠空白/标点切；切不出来就整串当一个词。"""
+    return [t for t in _TERM_SPLIT.split(q.strip()) if t.strip()][:_MAX_TERMS]
+
+
+def _personal_score_and_match(body_expr: str, n_terms: int, op: str) -> tuple[str, str]:
+    """生成 mem.doc / mem.conv 共用的排序表达式与过滤条件。
+
+    过滤：每个词都要命中（op='and'，与词序无关）；op='or' 是兜底放宽。
+    排序：标题全词命中 > 词覆盖度（word_similarity） > 命中密度 > 整串相似度。
+    """
+    joiner = " and " if op == "and" else " or "
+    in_title = [f"title ilike %(p{i})s" for i in range(n_terms)]
+    match = joiner.join(
+        f"(title ilike %(p{i})s or {body_expr} ilike %(p{i})s)" for i in range(n_terms)
+    )
+    w_title = [f"word_similarity(lower(%(t{i})s), lower(title))" for i in range(n_terms)]
+    w_body = [f"word_similarity(lower(%(t{i})s), lower({body_expr}))" for i in range(n_terms)]
+    density = [
+        f"(length(lower({body_expr}))"
+        f" - length(replace(lower({body_expr}), lower(%(t{i})s), '')))::float"
+        f" / greatest(length(%(t{i})s), 1) / greatest(length({body_expr}), 1)"
+        for i in range(n_terms)
+    ]
+    score = (
+        f"(case when {' and '.join(in_title)} then 0.6 else 0 end)"
+        f" + ({' + '.join(w_title)}) / {n_terms}.0"
+        f" + ({' + '.join(w_body)}) / {n_terms}.0 * 0.5"
+        f" + ({' + '.join(density)}) / {n_terms}.0 * 100.0"
+        " + similarity(lower(title), lower(%(q)s)) * 0.3"
+    )
+    return score, match
+
+
+def _personal_rows(
+    cur, params: dict[str, Any], n_terms: int, limit: int, op: str
+) -> list[dict[str, Any]]:
+    score_doc, match_doc = _personal_score_and_match("body", n_terms, op)
+    score_conv, match_conv = _personal_score_and_match("coalesce(snippet, '')", n_terms, op)
+    rows: list[dict[str, Any]] = []
+    cur.execute(
+        f"""select path, kind, title, body, updated_at, {score_doc} as score
+            from mem.doc
+            where user_id = %(uid)s and ({match_doc})
+            order by score desc, updated_at desc limit %(lim)s""",
+        params,
+    )
+    for row in cur.fetchall():
+        rows.append({
+            "scope": "personal",
+            "source": "mem.doc",
+            "kind": row[1],
+            "id": row[0],
+            "title": row[2] or "",
+            "snippet": _snippet(row[3]),
+            "date": row[4].isoformat() if row[4] else None,
+            "score": round(float(row[5]), 4),
+        })
+    cur.execute(
+        f"""select id, source, title, snippet, updated_at, {score_conv} as score
+            from mem.conv
+            where user_id = %(uid)s and ({match_conv})
+            order by score desc, updated_at desc limit %(lim)s""",
+        params,
+    )
+    for row in cur.fetchall():
+        rows.append({
+            "scope": "personal",
+            "source": "mem.conv",
+            "kind": "conversation",
+            "id": row[0],
+            "title": row[2] or row[1],
+            "snippet": _snippet(row[3] or ""),
+            "date": row[4].isoformat() if row[4] else None,
+            "score": round(float(row[5]), 4),
+        })
+    rows.sort(key=lambda x: (x.get("score") or 0.0, x.get("date") or ""), reverse=True)
+    return rows[:limit]
+
